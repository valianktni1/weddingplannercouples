# Copy to /mnt/apps/weddingplannercouples.env; keep it OUTSIDE the Git checkout.
SECURE_COOKIES=1
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
# Optional. Leave blank until you choose to open checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional independent read-only dashboard connection (not the Booking invitation key).
PLANNER_CONTROL_CENTRE_ENABLED=false
# PLANNER_CONTROL_CENTRE_KEY=use-a-separate-random-key-of-at-least-32-characters
